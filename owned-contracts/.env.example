# Deploy with a Foundry keystore, not a raw private key:
#   cast wallet import owned-deployer --interactive
#   forge script script/DeployFactory.s.sol --rpc-url base_sepolia --broadcast --verify --account owned-deployer

# Base Sepolia test USDC. Mainnet: 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# Platform Safe. Receives the 3% and holds the raise-only price cap power.
FEE_RECIPIENT=0xYourSafe
FACTORY_OWNER=0xYourSafe

# Optional overrides
FEE_BPS=300
PRICE_CAP=500000000

# BaseScan API key for verification
BASESCAN_API_KEY=your_basescan_api_key_here
